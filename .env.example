# DedupeIQ Environment Configuration
# When deploying to Vercel or connecting to Neon / remote PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# When left blank or unset, DedupeIQ automatically runs with embedded PostgreSQL (PGlite)
# and persistent storage in ./.data/dedupeiq.db with pg_trgm & fuzzystrmatch enabled.
DATABASE_URL=
